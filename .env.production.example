# Production Django configuration. Use newly rotated credentials and set these
# values in your hosting provider's environment settings, not in this template.
DJANGO_SECRET_KEY=replace-with-a-new-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-api-hostname

# Production PostgreSQL connection string (include ?sslmode=require if required
# by your database provider).
DATABASE_URL=postgresql://user:password@host:port/database

# Frontend origins, with no trailing slash for CORS_ALLOWED_ORIGINS.
FRONTEND_URL=https://your-frontend-hostname
CORS_ALLOWED_ORIGINS=https://your-frontend-hostname
CSRF_TRUSTED_ORIGINS=https://your-api-hostname

# Optional Supabase S3-compatible media storage.
SUPABASE_S3_ENDPOINT_URL=https://your-project.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=replace-with-a-new-access-key
SUPABASE_S3_SECRET_ACCESS_KEY=replace-with-a-new-secret-key
SUPABASE_S3_REGION=eu-west-1
SUPABASE_S3_BUCKET=cpmpts-files